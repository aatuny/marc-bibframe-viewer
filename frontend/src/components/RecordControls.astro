<div class="bf-viewer-controls">
  <h3>Tool</h3>

  <form id="bf-lookup" autocomplete="off">
    <div class="bf-viewer-field">
      <label for="bf-lookup-kind">Search parameter</label>
      <select id="bf-lookup-kind">
        <option value="key">(003)001</option>
      </select>
    </div>

    <div class="bf-viewer-field">
      <label for="bf-lookup-value"></label>
      <input id="bf-lookup-value" type="text" />
    </div>

    <button type="submit">Search</button>
  </form>

  <div class="bf-viewer-nav">
    <button id="bf-prev" disabled>
      Previous
    </button>
    <button id="bf-next" disabled>
      Next
    </button>
  </div>
</div>

<p id="bf-status" role="status" aria-live="polite"></p>

<style>
  .bf-viewer-controls {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-block-end: 1rem;
  }

  .bf-viewer-nav {
    display: flex;
    gap: 0.5rem;
  }

  .bf-viewer-field {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  #bf-lookup {
    display: flex;
    align-items: end;
    gap: 1rem;
  }

  #bf-status {
    min-height: 1.5em;
    margin-block: 0.5rem;
  }
</style>

<script>
  import {
    fetchRecord,
    type RecordResponse,
    type RecordQuery,
  } from "@/utils/bf-viewer/api.ts";
  import { RECORD_LOADED } from "@/utils/bf-viewer/events.ts";
  import { requireElement } from "@/utils/dom.ts";

  const prevButton = requireElement("bf-prev") as HTMLButtonElement;
  const nextButton = requireElement("bf-next") as HTMLButtonElement;

  const lookupKind = requireElement("bf-lookup-kind") as HTMLInputElement;
  const lookupValue = requireElement("bf-lookup-value") as HTMLInputElement;

  const lookupForm = requireElement("bf-lookup");
  const statusLine = requireElement("bf-status");

  let current: null | RecordResponse = null;

  async function load(q: RecordQuery) {
    statusLine.textContent = "Loading…";
    prevButton.disabled = true;
    nextButton.disabled = true;

    try {
      current = await fetchRecord(q);
      updateUrl(q);
    } catch (error) {
      if (error instanceof Error) {
        statusLine.textContent = `Could not load record (${error.message})`;
      } else {
        statusLine.textContent = `Could not load record because of unknown reason`;
      }

      return;
    }

    document.dispatchEvent(new CustomEvent(RECORD_LOADED, { detail: current }));

    const newInputValue = current.key;

    lookupValue.value = newInputValue;

    prevButton.disabled = current.record_index === 0;
    nextButton.disabled = !current.has_next;

    statusLine.textContent = ``;
  }

  prevButton.addEventListener("click", () => {
    if (current) load({ record_index: current.record_index - 1 });
  });

  nextButton.addEventListener("click", () => {
    if (current) load({ record_index: current.record_index + 1 });
  });

  lookupKind.addEventListener("change", () => {
    lookupValue.value = current?.key || "";
  });

  lookupForm.addEventListener("submit", (event) => {
    event.preventDefault();
    load({ key: lookupValue.value.trim() });
  });

  function loadUrlParams(): RecordQuery {
    const searchParams = new URLSearchParams(location.search);
    const key = searchParams.get("key");

    if (key) {
      return { key };
    }

    return {};
  }

  function updateUrl(query: RecordQuery) {
    const search = new URLSearchParams();

    // Just for typing to work
    for (const [k, v] of Object.entries(query)) {
      if (!v) {
        continue;
      }
      search.set(k, String(v));
    }

    const stringSearchParams = search.toString();
    const newUrl = stringSearchParams
      ? `?${stringSearchParams}`
      : location.pathname;

    history.replaceState(null, "", newUrl);
  }

  // Load params from URL
  const initialParams = loadUrlParams();

  // Sync UI
  if (initialParams.key) {
    lookupKind.value = "key";
    lookupValue.value = initialParams.key;
  }

  load(initialParams);
</script>
